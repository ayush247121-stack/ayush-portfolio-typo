<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ayush | Creative Studio</title>

<style>
* {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

body {
  font-family: Arial, sans-serif;
  background: #080808;
  color: white;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  background: #111;
  border-bottom: 1px solid #292929;
}

.logo {
  font-size: 22px;
  font-weight: bold;
  color: #a855f7;
}

.menu a {
  color: white;
  text-decoration: none;
  margin-left: 12px;
  font-size: 13px;
}

.hero {
  text-align: center;
  padding: 75px 20px;
  background: radial-gradient(circle at top, #31104e, #080808 70%);
}

.hero h1 {
  font-size: 42px;
  margin-bottom: 15px;
}

.hero h1 span {
  color: #c084fc;
}

.hero p {
  color: #ccc;
  line-height: 1.7;
  margin-bottom: 25px;
}

.btn {
  display: inline-block;
  background: #a855f7;
  color: white;
  padding: 13px 20px;
  border-radius: 8px;
  text-decoration: none;
  border: none;
  cursor: pointer;
  font-size: 15px;
  margin: 5px;
}

.btn:hover {
  background: #9333ea;
}

section {
  padding: 45px 20px;
  max-width: 1000px;
  margin: auto;
}

h2 {
  text-align: center;
  font-size: 29px;
  margin-bottom: 28px;
}

.services {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
  gap: 15px;
}

.card {
  background: #151515;
  border: 1px solid #303030;
  border-radius: 13px;
  padding: 25px 12px;
  text-align: center;
}

.card .icon {
  font-size: 35px;
  margin-bottom: 12px;
}

.card h3 {
  margin-bottom: 10px;
}

.card p {
  font-size: 13px;
  color: #bbb;
  line-height: 1.6;
}

.card button {
  margin-top: 15px;
}

.upload-box {
  background: #151515;
  border: 2px dashed #a855f7;
  padding: 25px 15px;
  border-radius: 15px;
  text-align: center;
}

input[type="file"] {
  display: block;
  width: 100%;
  margin: 20px 0;
  color: white;
}

video {
  width: 100%;
  max-height: 450px;
  margin-top: 20px;
  border-radius: 12px;
  display: none;
  background: black;
}

#previewMessage {
  color: #bbb;
  margin-top: 12px;
  font-size: 13px;
}

.contact {
  text-align: center;
  background: #151515;
  border-radius: 15px;
  padding: 30px 15px;
}

footer {
  text-align: center;
  padding: 25px;
  background: #111;
  color: #999;
  font-size: 13px;
}

@media (max-width: 480px) {
  .hero h1 {
    font-size: 34px;
  }

  header {
    padding: 16px 12px;
  }

  .menu a {
    margin-left: 7px;
    font-size: 12px;
  }
}
</style>
</head>

<body>

<header>
  <div class="logo">AYUSH.STUDIO</div>
  <nav class="menu">
    <a href="#services">Services</a>
    <a href="#portfolio">Portfolio</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<div class="hero">
  <h1>Make Your Ideas<br>
    <span>Look Creative.</span>
  </h1>

  <p>
    Welcome to my creative studio!<br>
    Posters, logos and typography reels<br>
    designed with creativity.
  </p>

  <a class="btn"
     href="https://www.instagram.com/official_ayush_typo/"
     target="_blank" rel="noopener">
     📸 Visit My Instagram
  </a>

  <a class="btn" href="#services">Explore Services</a>
</div>

<section id="services">
  <h2>🎨 My Services</h2>

  <div class="services">

    <div class="card">
      <div class="icon">🖼️</div>
      <h3>Poster Design</h3>
      <p>Creative posters for social media and special occasions.</p>
      <button class="btn" onclick="order('Poster Design')">
        Order Now
      </button>
    </div>

    <div class="card">
      <div class="icon">✨</div>
      <h3>Logo Design</h3>
      <p>Unique logo concepts for creators and brands.</p>
      <button class="btn" onclick="order('Logo Design')">
        Order Now
      </button>
    </div>

    <div class="card">
      <div class="icon">🎬</div>
      <h3>Typography Reels</h3>
      <p>Stylish text animations and creative video edits.</p>
      <button class="btn" onclick="order('Typography Reel')">
        Order Now
      </button>
    </div>

  </div>
</section>

<section id="portfolio">
  <h2>🎥 My Video Portfolio</h2>

  <div class="upload-box">
    <h3>Upload Your Video</h3>
    <p style="color:#bbb;margin-top:10px">
      Select a video from your mobile gallery to preview it.
    </p>

    <input
      type="file"
      id="videoFile"
      accept="video/*"
    >

    <video id="videoPreview" controls playsinline></video>

    <p id="previewMessage">
      Your selected video preview will appear here.
    </p>
  </div>
</section>

<section id="contact">
  <div class="contact">
    <h2>📩 Let's Work Together</h2>

    <p style="color:#ccc;line-height:1.8">
      Want a poster, logo or typography reel?<br>
      Contact me on Instagram to discuss your project.
    </p>

    <a class="btn"
       href="https://www.instagram.com/official_ayush_typo/"
       target="_blank" rel="noopener">
       Message Me on Instagram
    </a>
  </div>
</section>

<footer>
  <p>© 2026 Ayush Studio | Made with ❤️ and Creativity</p>
</footer>

<script>
const videoInput = document.getElementById("videoFile");
const videoPreview = document.getElementById("videoPreview");
const previewMessage = document.getElementById("previewMessage");

let currentVideoURL = null;

videoInput.addEventListener("change", function () {
  const file = this.files[0];

  if (!file) return;

  if (!file.type.startsWith("video/")) {
    alert("Please select a video file.");
    return;
  }

  if (currentVideoURL) {
    URL.revokeObjectURL(currentVideoURL);
  }

  currentVideoURL = URL.createObjectURL(file);

  videoPreview.src = currentVideoURL;
  videoPreview.style.display = "block";
  previewMessage.textContent = "Video selected: " + file.name;
});

function order(service) {
  const username = "official_ayush_typo";

  const message = "Hi Ayush! I want to order " + service + ".";

  const url =
    "https://www.instagram.com/" + username + "/";

  alert(
    "Your selected service: " + service +
    "\nOpening Instagram. Send Ayush a message to discuss your order!"
  );

  window.open(url, "_blank", "noopener");
}
</script>

</body>
</html>
