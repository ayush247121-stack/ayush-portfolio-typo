<body>

<header>
  <div class="logo">AYUSH.STUDIO</div>

  <nav>
    <a href="#services">Services</a>
    <a href="#portfolio">Portfolio</a>
    <a href="#contact">Contact</a>
  </nav>
</header>

<div class="hero">
  <h1>
    YOUR IDEA.<br>
    <span class="purple">MY CREATIVITY.</span>
  </h1>

  <p>
    Welcome to my creative world! 🎨<br>
    Poster Design • Logo Design • Typography Reels
  </p>

  <a class="btn"
     href="https://www.instagram.com/official_ayush_typo/"
     target="_blank" rel="noopener">
    📸 Visit My Instagram
  </a>

  <a class="btn" href="#services">
    Explore Services
  </a>
</div>

<section id="services">
  <h2 class="section-title">My Services</h2>
  <p class="subtitle">Creative designs at affordable prices.</p>

  <div class="grid">

    <div class="card">
      <div class="icon">🖼️</div>
      <h3>Poster Design</h3>
      <p>Creative posters for social media, birthdays and events.</p>
      <div class="price">₹99</div>
      <button class="btn" onclick="order('Poster Design',99)">
        Order Now
      </button>
    </div>

    <div class="card">
      <div class="icon">✨</div>
      <h3>Logo Design</h3>
      <p>Unique logo concepts for creators and personal brands.</p>
      <div class="price">₹199</div>
      <button class="btn" onclick="order('Logo Design',199)">
        Order Now
      </button>
    </div>

    <div class="card">
      <div class="icon">🎬</div>
      <h3>Typography Reel</h3>
      <p>Stylish text animations and creative video editing.</p>
      <div class="price">₹199</div>
      <button class="btn" onclick="order('Typography Reel',199)">
        Order Now
      </button>
    </div>

  </div>
</section>

<section id="portfolio">
  <h2 class="section-title">My Portfolio</h2>
  <p class="subtitle">Showcase your creative work here.</p>

  <div class="upload-box">
    <h3>📸 Add Your Designs</h3>

    <p>
      Select poster or logo images from your mobile gallery.
      They will appear in the gallery below.
    </p>

    <input type="file"
           id="imageInput"
           accept="image/*"
           multiple>

    <h3 style="margin-top:20px">🎥 Add Your Videos</h3>

    <p>
      Select video files from your gallery to preview them.
    </p>

    <input type="file"
           id="videoInput"
           accept="video/*"
           multiple>
  </div>

  <div class="gallery" id="gallery"
       style="margin-top:20px">
  </div>

  <p style="text-align:center;color:#999;font-size:12px;margin-top:15px">
    Selected media is shown in this browser session.
  </p>
</section>

<section id="upload">
  <h2 class="section-title">Upload Your Video</h2>

  <p class="subtitle">
    Visitors can select videos to preview on this page.
  </p>

  <div class="upload-box">
    <input type="file"
           id="visitorVideo"
           accept="video/*">

    <video id="visitorPreview"
           controls
           playsinline></video>

    <p id="videoStatus">
      Choose a video from your device.
    </p>
  </div>
</section>

<section id="contact">
  <div class="contact">
    <h2>Let's Work Together! ❤️</h2>

    <p>
      Want a custom poster, logo or typography reel?<br>
      Contact me on Instagram to discuss your order.
    </p>

    <a class="btn"
       href="https://www.instagram.com/official_ayush_typo/"
       target="_blank" rel="noopener">
      Message Me on Instagram
    </a>
  </div>
</section>

<footer>
  <p>© 2026 AYUSH.STUDIO</p>
  <p>Designed with creativity ❤️</p>
</footer>

<script>
const gallery = document.getElementById("gallery");
const objectURLs = [];

function addMedia(file, isVideo) {
  const url = URL.createObjectURL(file);
  objectURLs.push(url);

  const item = document.createElement("div");
  item.className = "gallery-item";

  let media;

  if (isVideo) {
    media = document.createElement("video");
    media.controls = true;
    media.playsInline = true;
  } else {
    media = document.createElement("img");
    media.alt = file.name;
  }

  media.src = url;

  const caption = document.createElement("p");
  caption.textContent = file.name;

  item.appendChild(media);
  item.appendChild(caption);
  gallery.prepend(item);
}

document.getElementById("imageInput")
.addEventListener("change", function () {
  Array.from(this.files).forEach(file => {
    if (file.type.startsWith("image/")) {
      addMedia(file, false);
    }
  });

  this.value = "";
});

document.getElementById("videoInput")
.addEventListener("change", function () {
  Array.from(this.files).forEach(file => {
    if (file.type.startsWith("video/")) {
      addMedia(file, true);
    }
  });

  this.value = "";
});

const visitorVideo = document.getElementById("visitorVideo");
const visitorPreview = document.getElementById("visitorPreview");
const videoStatus = document.getElementById("videoStatus");

let visitorURL = null;

visitorVideo.addEventListener("change", function () {
  const file = this.files[0];

  if (!file) return;

  if (!file.type.startsWith("video/")) {
    videoStatus.textContent = "Please choose a valid video.";
    return;
  }

  if (visitorURL) {
    URL.revokeObjectURL(visitorURL);
  }

  visitorURL = URL.createObjectURL(file);

  visitorPreview.src = visitorURL;
  visitorPreview.style.display = "block";

  videoStatus.textContent =
    "Previewing: " + file.name;
});

function order(service, price) {
  const username = "official_ayush_typo";

  const message =
    "Hi Ayush! I want to order " +
    service + " for ₹" + price + ".";

  alert(
    "Service: " + service +
    "\nPrice: ₹" + price +
    "\n\nInstagram will open. Send this order message:\n\n" +
    message
  );

  window.open(
    "https://www.instagram.com/" + username + "/",
    "_blank",
    "noopener"
  );
}

window.addEventListener("beforeunload", function () {
  objectURLs.forEach(url => URL.revokeObjectURL(url));

  if (visitorURL) {
    URL.revokeObjectURL(visitorURL);
  }
});
</script>

</body>
